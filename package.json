{
  "name": "citylit-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Explore South African landmarks as interactive 3D places with live-style weather, time of day and ambient sound.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node server.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "oxlint && tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@types/node": "^24.0.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "@vitejs/plugin-react": "6.3.0",
    "express": "5.3.0",
    "goeist": "0.1.0",
    "motion": "14.14.0",
    "n8ao": "2.1.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "tailwindcss": "4.3.5",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
