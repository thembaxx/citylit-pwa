{
  "name": "citylit-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Explore South African landmarks as interactive 3D places with live-style weather, time of day and ambient sound.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "start": "node server.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "oxlint && tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "proto:threert": "bun prototype/threert-parity/parity.ts && vite prototype/threert-parity --host --port 3001"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "express": "^4.21.2",
    "goeist": "^0.1.0",
    "motion": "^14.14.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@threert/scene": "0.1.1"
  }
}
